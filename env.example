FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 또는 Application Default Credentials 사용
# GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# 이 애플리케이션의 외부 기준 URL
NEXT_PUBLIC_APP_URL=http://localhost:3005

# HAMS SSO 서버
HAMS_OAUTH_SERVER_URL=http://localhost:3000
HAMS_OAUTH_CLIENT_ID=
HAMS_OAUTH_CLIENT_SECRET=

# 서비스마다 별도로 생성한 서버 전용 난수
HAMS_COOKIE_PREFIX=
HAMS_SESSION_SECRET=

# 선택 사항. 유효한 양의 정수가 아니면 기본값 604800(7일)을 사용한다.
HAMS_SSO_SESSION_MAX_AGE_SEC=604800

# 임시 로그인 mock data 사용 허용
NEXT_PUBLIC_DEV_MOCK_LOGIN=false
HAMS_SSO_DEV_MOCK_USER_ID=
HAMS_SSO_DEV_MOCK_USER_EMAIL=
HAMS_SSO_DEV_MOCK_USER_LOGIN_ID=
HAMS_SSO_DEV_MOCK_USER_NAME=
